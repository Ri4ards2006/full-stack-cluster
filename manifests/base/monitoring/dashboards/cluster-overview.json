    {
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Node CPU Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Node Memory Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Tailscale WireGuard Bandwidth (tailscale0)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device=\"tailscale0\"}[5m])",
          "legendFormat": "RX {{instance}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device=\"tailscale0\"}[5m])",
          "legendFormat": "TX {{instance}}"
        }
      ]
    }
