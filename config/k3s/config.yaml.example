# ==============================================================================
# Declarative K3s Server (Master Control Plane) Configuration
# Location on Master Node: /etc/rancher/k3s/config.yaml
# ==============================================================================

# Explicitly bind node and advertise addresses to the Tailscale Mesh interface
flannel-iface: tailscale0
node-ip: 100.x.y.z                 # Replace with ThinkPad Tailscale IP
advertise-address: 100.x.y.z       # Replace with ThinkPad Tailscale IP

# 1. MTU Optimization for Flannel over WireGuard (Tailscale 1280 MTU baseline)
# 1280 MTU - 50 bytes (VXLAN overhead) = 1230 MTU
flannel-backend: vxlan
flannel-conf: '{"Network":"10.42.0.0/16","Backend":{"Type":"vxlan","Port":8472,"MTU":1230}}'

# 2. DNS Loopback Fix (Bypasses Arch Linux / systemd-resolved 127.0.0.53 loop)
resolv-conf: /etc/rancher/k3s/resolv.conf

# 3. Kubeconfig Access & TLS SANs (Prevents certificate SAN mismatch errors)
write-kubeconfig-mode: "0644"
tls-san:
  - "100.x.y.z"                    # Tailscale Master IP
  - "thinkpad-l480"                # Master Hostname
  - "192.168.178.x"                # Local LAN IP

# 4. Service CIDR & Cluster Pod Network
cluster-cidr: "10.42.0.0/16"
service-cidr: "10.43.0.0/16"
cluster-dns: "10.43.0.10"
