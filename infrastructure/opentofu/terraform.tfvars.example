# ==============================================================================
# OpenTofu Variable Assignments Example (terraform.tfvars)
# Copy this file to 'terraform.tfvars' and insert your secret tokens.
# ==============================================================================

hcloud_token       = "CHANGE_ME_TO_HETZNER_CLOUD_API_TOKEN"
server_type        = "cx22"
location           = "fsn1"
ssh_public_key     = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@homelab"
tailscale_auth_key = "tskey-auth-kxxxxxxxxxxxxxxxxxxxxxxx"
k3s_master_ip      = "100.x.y.z"
k3s_cluster_token  = "CHANGE_ME_TO_A_SECURE_RANDOM_TOKEN"
